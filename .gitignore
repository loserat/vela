# Generated Android SDK files and local packages
/app/build/
/app/deps/
/dist/
*.apk
*.aab
*.apks
*.idsig

# Python caches and operating-system files
__pycache__/
*.pyc
.DS_Store

# Private signing material and local credentials
*.p12
*.pfx
*.jks
*.keystore
*.pem
*.key
*.p8
*.pk8
.env
.env.*
!.env.example
*.cookies
*.enc
*.db
*.db-*
*.log

# Known unencrypted local setup files; keep JSON source/catalogs trackable
leise-tv-camera-config.json
hue-bridge-local.json

# Local work, integration evidence and explicitly private filenames
/work/
/outputs/
/test-results/
*private*

# Images require an explicit reviewed exception, including uppercase extensions
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]

